<view class="chat-page">
  <scroll-view
    class="msg-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation="{{true}}"
  >
    <view class="msg-pad">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
        class="msg-row {{item.fromRole === 'user' ? 'msg-row--mine' : 'msg-row--other'}}"
      >
        <view class="avatar avatar--other" wx:if="{{item.fromRole !== 'user'}}">
          <text class="avatar-text">客</text>
        </view>
        <view class="col-bubble">
          <view wx:if="{{item.orderNo}}" class="order-tag" bindtap="onCopyOrderNo" data-orderno="{{item.orderNo}}">
            订单 {{item.orderNo}}
          </view>
          <view wx:if="{{item.msgType === 'text'}}" class="bubble bubble--text">{{item.content}}</view>
          <image
            wx:elif="{{item.msgType === 'image'}}"
            class="bubble bubble--img"
            src="{{item.displayUrl}}"
            mode="widthFix"
            lazy-load="{{true}}"
            bindtap="onPreviewImage"
            data-url="{{item.displayUrl}}"
          />
          <view
            wx:elif="{{item.msgType === 'voice'}}"
            class="bubble bubble--voice {{item.fromRole === 'user' ? 'bubble--voice--mine' : 'bubble--voice--other'}}"
            style="width: {{item.voiceBarWidth}}rpx;"
            bindtap="onPlayVoice"
            data-url="{{item.displayUrl}}"
            data-id="{{item.id}}"
          >
            <view class="voice-inner voice-inner--mine" wx:if="{{item.fromRole === 'user'}}">
              <text class="voice-sec">{{item.voiceSec}}″</text>
              <image
                class="voice-icon {{playingVoiceId == item.id ? 'voice-icon--playing' : ''}}"
                src="/assets/chat-voice-icon.png"
                mode="aspectFit"
              />
            </view>
            <view class="voice-inner" wx:else>
              <image
                class="voice-icon voice-icon--other {{playingVoiceId == item.id ? 'voice-icon--playing' : ''}}"
                src="/assets/chat-voice-icon.png"
                mode="aspectFit"
              />
              <text class="voice-sec">{{item.voiceSec}}″</text>
            </view>
          </view>
          <view wx:else class="bubble bubble--text">{{item.content}}</view>
        </view>
        <view class="avatar avatar--mine" wx:if="{{item.fromRole === 'user'}}">
          <image wx:if="{{myAvatarUrl}}" class="avatar-img" src="{{myAvatarUrl}}" mode="aspectFill" />
          <text wx:else class="avatar-text">我</text>
        </view>
      </view>
      <view class="scroll-bottom-anchor" id="msg-bottom"></view>
    </view>
  </scroll-view>

  <view wx:if="{{recording}}" class="record-overlay" catchtouchmove="noop">
    <view class="record-panel {{recordWillCancel ? 'record-panel--cancel' : ''}}">
      <view class="record-icon-wrap">
        <image class="record-panel-icon" src="/assets/chat-voice-icon.png" mode="aspectFit" />
      </view>
      <text class="record-hint">{{recordWillCancel ? '松开手指，取消发送' : '拖动到下方 X 区域取消'}}</text>
    </view>
    <view class="record-cancel-zone {{recordWillCancel ? 'record-cancel-zone--active' : ''}}">
      <text class="record-cancel-x">X</text>
    </view>
  </view>

  <view wx:if="{{peerTyping}}" class="typing-tip">对方正在输入…</view>

  <view wx:if="{{selectedOrderNo}}" class="selected-order">
    已关联订单：<text class="selected-order-no">{{selectedOrderNo}}</text>
    <text class="selected-order-clear" bindtap="onClearSelectedOrder">取消</text>
  </view>

  <view class="input-dock safe-bottom">
    <view class="circle-btn" hover-class="circle-btn--hover" bindtap="toggleInputMode">
      <image wx:if="{{inputMode !== 'voice'}}" class="circle-icon" src="/assets/chat-voice-icon.png" mode="aspectFit" />
      <text wx:else class="circle-keyboard">⌨</text>
    </view>

    <block wx:if="{{inputMode !== 'voice'}}">
      <view class="text-field-wrap">
        <input
          class="text-field"
          placeholder="发送消息"
          placeholder-class="text-field-ph"
          confirm-type="send"
          confirm-hold="{{false}}"
          value="{{inputText}}"
          bindinput="onInput"
          bindconfirm="onSend"
        />
        <view class="inline-mic" hover-class="inline-mic--hover" bindtap="toggleInputMode">
          <text class="inline-mic-icon">🎤</text>
        </view>
      </view>
    </block>
    <view
      wx:else
      class="press-talk {{recording ? 'press-talk--active' : ''}}"
      catchtouchstart="onRecordStart"
      catchtouchmove="onRecordMove"
      catchtouchend="onRecordEnd"
      catchtouchcancel="onRecordCancel"
    >
      {{recording ? '松开 发送' : '按住 说话'}}
    </view>

    <view class="circle-btn circle-btn--side" hover-class="circle-btn--hover" bindtap="onEmojiTap">
      <text class="circle-emoji">☺</text>
    </view>
    <view class="circle-btn circle-btn--side" hover-class="circle-btn--hover" bindtap="openMoreActions">
      <text class="circle-plus">+</text>
    </view>
  </view>

  <view wx:if="{{showEmojiPanel}}" class="emoji-panel safe-bottom">
    <view class="emoji-grid">
      <view
        wx:for="{{emojiList}}"
        wx:key="*this"
        class="emoji-item"
        data-emoji="{{item}}"
        bindtap="onPickEmoji"
      >
        {{item}}
      </view>
    </view>
  </view>
</view>
<t-toast id="t-toast" />
