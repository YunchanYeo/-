.support-page { display: flex; flex-direction: column; height: 100vh; background: #f5f5f5; }
.msg-list { flex: 1; overflow: auto; padding: 20rpx; }
.msg-item { display: flex; margin-bottom: 16rpx; }
.msg-item.mine { justify-content: flex-end; }
.msg-item.admin { justify-content: flex-start; }
.bubble { max-width: 70%; padding: 14rpx 18rpx; border-radius: 12rpx; background: #fff; color: #333; word-break: break-word; }
.msg-item.mine .bubble { background: #95ec69; }
.chat-img { max-width: 420rpx; border-radius: 12rpx; background: #eee; }
.voice-bubble {
  max-width: 70%;
  min-width: 160rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.msg-item.mine .voice-bubble { background: #95ec69; }
.voice-icon { font-size: 24rpx; color: #fa550f; }
.voice-dur { font-size: 24rpx; color: #333; }
.input-bar { display: flex; align-items: center; padding: 16rpx; background: #fff; border-top: 1px solid #eee; }
.left-action {
  width: 68rpx;
  height: 68rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 30rpx;
  color: #666;
  border: 1px solid #cdcdcd;
  background: #fff;
}
.left-action.is-recording {
  background: #ffe8d9;
  border-color: #fa550f;
}
.input { flex: 1; height: 68rpx; background: #fff; border-radius: 10rpx; padding: 0 20rpx; border: 1px solid #ddd; }
.hold-to-talk {
  flex: 1;
  height: 68rpx;
  border-radius: 10rpx;
  border: 1px solid #ddd;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  font-size: 26rpx;
}
.hold-to-talk.is-recording {
  background: #f1f1f1;
}
.right-action {
  width: 68rpx;
  height: 68rpx;
  border-radius: 12rpx;
  border: 1px solid #cdcdcd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #666;
  line-height: 1;
  margin-left: 12rpx;
  background: #fff;
}
.send { margin-left: 12rpx; background: #fa550f; color: #fff; border-radius: 10rpx; padding: 0 24rpx; height: 68rpx; line-height: 68rpx; }

