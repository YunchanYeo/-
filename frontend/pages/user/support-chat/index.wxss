/* 参考微信聊天：浅灰底、左右头像、绿/白气泡、底部输入条 */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ededed;
  box-sizing: border-box;
}

.msg-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}

.msg-pad {
  padding: 24rpx 20rpx 20rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.msg-row--mine {
  flex-direction: row;
  justify-content: flex-end;
}

.msg-row--other {
  flex-direction: row;
  justify-content: flex-start;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar--other {
  margin-right: 16rpx;
  background: linear-gradient(145deg, #ff9a5a, #fa550f);
}

.avatar--mine {
  margin-left: 16rpx;
  background: linear-gradient(145deg, #7bc96f, #07c160);
}

.avatar-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.col-bubble {
  max-width: calc(100% - 200rpx);
  display: flex;
  flex-direction: column;
}

.msg-row--mine .col-bubble {
  align-items: flex-end;
}

.msg-row--other .col-bubble {
  align-items: flex-start;
}

.bubble--text {
  max-width: 100%;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: #111;
  word-break: break-word;
  box-sizing: border-box;
}

.msg-row--other .bubble--text {
  background: #fff;
  border-top-left-radius: 4rpx;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.04);
}

.msg-row--mine .bubble--text {
  background: #95ec69;
  border-top-right-radius: 4rpx;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.06);
}

.bubble--img {
  max-width: 460rpx;
  border-radius: 12rpx;
  vertical-align: bottom;
  background: #e5e5e5;
}

.msg-row--mine .bubble--img {
  border-top-right-radius: 4rpx;
}

.msg-row--other .bubble--img {
  border-top-left-radius: 4rpx;
}

.bubble--voice {
  min-width: 148rpx;
  max-width: 100%;
  box-sizing: border-box;
  border-radius: 12rpx;
  padding: 0;
  overflow: visible;
  position: relative;
  z-index: 0;
}

.msg-row--other .bubble--voice {
  background: #fff;
  border-top-left-radius: 4rpx;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.04);
}

.msg-row--mine .bubble--voice {
  background: #95ec69;
  border-top-right-radius: 4rpx;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.06);
}

/* 语音气泡小三角（指向头像，贴近微信） */
.bubble--voice--mine::after {
  content: '';
  position: absolute;
  right: -11rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border: 10rpx solid transparent;
  border-left-color: #95ec69;
}

.bubble--voice--other::before {
  content: '';
  position: absolute;
  left: -11rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border: 10rpx solid transparent;
  border-right-color: #fff;
}

.voice-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 18rpx 20rpx;
  min-height: 72rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.voice-inner--mine {
  flex-direction: row-reverse;
  justify-content: flex-end;
}

.voice-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: block;
}

.voice-icon--other {
  opacity: 0.85;
}

@keyframes voice-playing {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.55;
    transform: scale(0.92);
  }
}

.voice-icon--playing {
  animation: voice-playing 0.85s ease-in-out infinite;
}

.voice-sec {
  font-size: 30rpx;
  color: #333;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.voice-inner--mine .voice-sec {
  margin-right: 14rpx;
}

.voice-inner:not(.voice-inner--mine) .voice-sec {
  margin-left: 14rpx;
}

.scroll-bottom-anchor {
  height: 1rpx;
  width: 100%;
}

/* 录音遮罩（微信按住说话） */
.record-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.record-panel {
  width: 360rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(60, 60, 60, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-panel--cancel {
  background: rgba(180, 50, 50, 0.92);
}

.record-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.record-panel-icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.record-hint {
  font-size: 28rpx;
  color: #fff;
  text-align: center;
  line-height: 1.5;
}

/* 底部输入区 */
.input-dock {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 16rpx 16rpx;
  background: #f7f7f7;
  border-top: 1rpx solid #d6d6d6;
  box-sizing: border-box;
  flex-shrink: 0;
}

.safe-bottom {
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.tool-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #cfcfcf;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tool-btn--hover {
  opacity: 0.85;
}

.tool-btn--plus {
  margin-left: 12rpx;
}

.tool-voice-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tool-icon-key {
  font-size: 34rpx;
  line-height: 1;
}

.tool-plus {
  font-size: 44rpx;
  color: #666;
  line-height: 1;
  font-weight: 300;
}

.text-field {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  margin-left: 12rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #d2d2d2;
  font-size: 30rpx;
  box-sizing: border-box;
}

.text-field-ph {
  color: #b2b2b2;
}

.press-talk {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  margin-left: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #d2d2d2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #111;
  font-weight: 500;
}

.press-talk--active {
  background: #e6e6e6;
}

.send-btn {
  margin-left: 12rpx;
  height: 72rpx !important;
  line-height: 72rpx !important;
  padding: 0 28rpx !important;
  font-size: 28rpx !important;
  background: #07c160 !important;
  color: #fff !important;
  border-radius: 12rpx !important;
  border: none !important;
  flex-shrink: 0;
}

.send-btn::after {
  border: none;
}
