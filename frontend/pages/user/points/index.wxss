.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx 24rpx;
}

.label {
  font-size: 26rpx;
  color: #777;
}

.value {
  margin-top: 12rpx;
  font-size: 56rpx;
  line-height: 1;
  color: #07c160;
  font-weight: 700;
}
