page {
  box-sizing: border-box;
  padding-bottom: calc(128rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  background: #f2f3f5;
}

.t-tabs.t-tabs--top .t-tabs__scroll {
  border-bottom: none !important;
}

.home-page-header {
  background: linear-gradient(180deg, #ffffff 0%, #f2f3f5 100%);
  padding: 0 24rpx 8rpx;
}

.home-page-container {
  display: block;
  padding: 0 24rpx 24rpx;
  background: #f2f3f5;
}

.home-page-header .t-search__input-container {
  border-radius: 40rpx !important;
  height: 72rpx !important;
  background: #f5f5f5 !important;
}

.home-page-header .t-search__input {
  font-size: 28rpx !important;
  color: #747474 !important;
}

.home-page-header .swiper-wrap {
  margin-top: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
  position: relative;
}

.banner-swiper {
  width: 100%;
  height: 380rpx;
}

.banner-slide {
  width: 100%;
  height: 380rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.banner-image {
  width: 100%;
  height: 380rpx;
}

.banner-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 16rpx;
  display: flex;
  justify-content: center;
  gap: 10rpx;
}

.banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.15);
}

.banner-dot--active {
  width: 24rpx;
  border-radius: 8rpx;
  background: #fa4126;
}

.section-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-head--goods {
  margin-bottom: 8rpx;
}

.section-head-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.2;
}

.section-sub {
  font-size: 22rpx;
  color: #999999;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #999999;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 24rpx;
  column-gap: 4rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.category-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.category-icon-img {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.category-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #333333;
  line-height: 1.3;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.hot-scroll {
  width: 100%;
}

.hot-scroll-inner {
  display: inline-flex;
  flex-direction: row;
  padding-right: 8rpx;
}

.hot-card {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 240rpx;
  height: 360rpx;
  margin-right: 20rpx;
  background: #fafafa;
  border-radius: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.hot-card:last-child {
  margin-right: 8rpx;
}

.hot-card__img-wrap {
  width: 240rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.hot-card__img {
  width: 240rpx;
  height: 200rpx;
  display: block;
}

.hot-card__body {
  flex: 1;
  min-height: 0;
  padding: 12rpx 14rpx 14rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hot-card__title {
  flex-shrink: 0;
  height: 68rpx;
  font-size: 24rpx;
  color: #333333;
  line-height: 34rpx;
  overflow: hidden;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hot-card__meta {
  margin-top: auto;
  padding-top: 8rpx;
  min-height: 40rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
}

.hot-card__price-row {
  flex: 1;
  min-width: 0;
  line-height: 1;
}

.hot-card__price {
  color: #fa4126;
  font-weight: 700;
  font-size: 28rpx;
  line-height: 40rpx;
}

.hot-card__price-empty {
  font-size: 26rpx;
  color: #fa4126;
  line-height: 40rpx;
}

.hot-card__sold {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #999999;
  line-height: 40rpx;
  white-space: nowrap;
}

.home-page-container .t-tabs {
  background: transparent !important;
}

.home-page-container .t-tabs .t-tabs-nav {
  background-color: transparent;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #666666;
}

.home-page-container .t-tabs .t-tabs-scroll {
  border: none !important;
}

.home-page-container .tabs-external__item {
  font-size: 26rpx;
}

.home-page-container .tabs-external__active {
  color: #fa4126 !important;
  font-size: 28rpx;
  font-weight: 600;
}

.home-page-container .tabs-external__track {
  background-color: #fa4126 !important;
  height: 6rpx !important;
  border-radius: 4rpx !important;
  width: 40rpx !important;
}

.t-tabs.t-tabs--top .t-tabs__item,
.t-tabs.t-tabs--bottom .t-tabs__item {
  height: 72rpx !important;
}

.home-page-container .goods-list-container {
  background: transparent !important;
  margin-top: 8rpx;
  padding: 0 !important;
}

.home-page-tabs {
  --td-tab-nav-bg-color: transparent;
  --td-tab-border-color: transparent;
  --td-tab-item-color: #666;
  --td-tab-track-color: #fa4126;
}

.goods-panel {
  padding-bottom: 8rpx;
}

/* 相对较低的屏幕比例 */
.home-page-container.viewport-compact .banner-swiper,
.home-page-container.viewport-compact .banner-slide,
.home-page-container.viewport-compact .banner-image {
  height: 320rpx;
}

.home-page-container.viewport-compact .hot-card {
  width: 220rpx;
  height: 332rpx;
}

.home-page-container.viewport-compact .hot-card__img-wrap,
.home-page-container.viewport-compact .hot-card__img {
  width: 220rpx;
  height: 180rpx;
}
