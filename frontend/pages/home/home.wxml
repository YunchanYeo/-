<view style="text-align: center; color: #b9b9b9" wx:if="{{pageLoading}}">
  <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
</view>

<view class="home-page-header">
  <view class="search" bind:tap="navToSearchPage">
    <t-search
      t-class-input="t-search__input"
      t-class-input-container="t-search__input-container"
      placeholder="{{searchPlaceholder}}"
      leftIcon=""
      disabled
    >
      <t-icon slot="left-icon" prefix="wr" name="search" size="40rpx" color="#bbb" />
    </t-search>
  </view>
  <view class="swiper-wrap" wx:if="{{bannerItems.length > 0}}">
    <swiper
      class="banner-swiper"
      circular
      autoplay
      interval="{{interval}}"
      duration="{{duration}}"
      current="{{current}}"
      bindchange="onBannerChange"
    >
      <swiper-item wx:for="{{bannerItems}}" wx:key="spuId" wx:for-index="bannerIdx">
        <view class="banner-slide" bindtap="onBannerClick" data-index="{{bannerIdx}}">
          <image class="banner-image" src="{{item.image}}" mode="aspectFit" />
        </view>
      </swiper-item>
    </swiper>
    <view class="banner-dots" wx:if="{{bannerItems.length > 1}}">
      <view
        wx:for="{{bannerItems}}"
        wx:key="spuId"
        class="banner-dot {{current === index ? 'banner-dot--active' : ''}}"
      />
    </view>
  </view>
</view>

<view class="home-page-container {{viewportClass}}">
  <view class="section-card category-panel" wx:if="{{categoryNav.length > 0}}">
    <view class="section-head">
      <text class="section-title">商品分类</text>
      <view class="section-more" bindtap="navToCategoryPage">
        <text>全部分类</text>
        <t-icon prefix="wr" name="arrow_forward" size="28rpx" color="#999" />
      </view>
    </view>
    <view class="category-grid">
      <view
        wx:for="{{categoryNav}}"
        wx:key="key"
        class="category-item"
        bindtap="onCategoryNavTap"
        data-name="{{item.categoryName}}"
      >
        <view class="category-icon-wrap">
          <image
            class="category-icon-img"
            src="{{item.thumb}}"
            mode="aspectFit"
            lazy-load="{{true}}"
          />
        </view>
        <text class="category-name">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view class="section-card hot-panel" wx:if="{{hotProducts.length > 0}}">
    <view class="section-head">
      <text class="section-title">热销推荐</text>
      <text class="section-sub">人气好物</text>
    </view>
    <scroll-view scroll-x class="hot-scroll" enhanced show-scrollbar="{{false}}">
      <view class="hot-scroll-inner">
        <view
          wx:for="{{hotProducts}}"
          wx:key="spuId"
          class="hot-card"
          bindtap="navToMarketingDetail"
          data-spuid="{{item.spuId}}"
          data-promotionid="{{item.promotionId || ''}}"
        >
          <view class="hot-card__img-wrap">
            <image class="hot-card__img" src="{{item.image}}" mode="aspectFit" />
          </view>
          <view class="hot-card__body">
            <text class="hot-card__title">{{item.title}}</text>
            <view class="hot-card__meta">
              <view class="hot-card__price-row">
                <price wx:if="{{item.price > 0}}" wr-class="hot-card__price" price="{{item.price}}" />
                <text wx:else class="hot-card__price-empty">面议</text>
              </view>
              <text class="hot-card__sold">已售 {{item.soldNum}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  <t-toast id="t-toast" />
</view>
