.tabbar-position {
  position: fixed !important;
  bottom: 0;
  left: 0;
  width: 100%;
}

.page-cat {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  min-height: 100vh;
  background-color: #f6f6f6;
  box-sizing: border-box;
}

.cat-side {
  width: 180rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.cat-side-item {
  padding: 32rpx 16rpx;
  font-size: 26rpx;
  line-height: 1.35;
  text-align: center;
  color: #666666;
  border-left: 6rpx solid transparent;
}

.cat-side-item--active {
  background-color: #ffffff;
  color: #fa550f;
  font-weight: 600;
  border-left-color: #fa550f;
}

.cat-main {
  flex: 1;
  min-width: 0;
  background-color: #ffffff;
  position: relative;
}

.cat-loading {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}

.cat-empty {
  padding-top: 80rpx;
}

.cat-goods-scroll {
  box-sizing: border-box;
  width: 100%;
}

/* 仅外层留白；两列布局由 goods-list / goods-card 组件内样式完成 */
.cat-goods-list-inner {
  padding: 12rpx 12rpx 32rpx;
  box-sizing: border-box;
}

page {
  min-height: none;
  padding-bottom: 0;
}
