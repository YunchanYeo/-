.admin-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: linear-gradient(180deg, #fff5ef 0%, #f7f8fa 42%, #f7f8fa 100%);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
}

.tabs {
  display: flex;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}

.tab {
  margin-right: 12rpx;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #666;
  font-size: 24rpx;
  transition: all 0.2s ease;
}

.tab.active {
  background: #ffede3;
  color: #fa550f;
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

.form-card {
  border: 1rpx solid #ffe4d3;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.image-preview {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin: 12rpx 0 16rpx;
  background: #f5f5f5;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #444;
}

.btn-row {
  display: flex;
  gap: 16rpx;
}
