.admin-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: linear-gradient(180deg, #fff5ef 0%, #f7f8fa 42%, #f7f8fa 100%);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
}

.tabs {
  display: flex;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}

.tab {
  margin-right: 12rpx;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #666;
  font-size: 24rpx;
  transition: all 0.2s ease;
}

.tab.active {
  background: #ffede3;
  color: #fa550f;
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

.form-card {
  border: 1rpx solid #ffe4d3;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.image-preview {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin: 12rpx 0 16rpx;
  background: #f5f5f5;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #444;
}

.row-right {
  max-width: 440rpx;
  text-align: right;
  word-break: break-all;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.order-detail {
  margin-top: 10rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
}

.order-detail-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.order-detail-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #333;
}

.order-detail-item__name {
  max-width: 520rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-detail-item__qty {
  color: #666;
}

.order-detail-empty {
  font-size: 26rpx;
  color: #888;
}

.hint-text {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.category-row {
  align-items: center;
}

.category-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.category-actions {
  flex-shrink: 0;
}

.muted-card {
  color: #888;
  font-size: 26rpx;
  text-align: center;
}
