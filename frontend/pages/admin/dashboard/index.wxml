<view class="admin-page">
  <view class="header">
    <view class="title">管理员后台</view>
    <view class="header-actions">
      <t-button size="small" variant="outline" bind:tap="gotoSupportChat">客服会话</t-button>
      <t-button size="small" variant="outline" bind:tap="gotoAdminSettings">账号设置</t-button>
      <t-button size="small" variant="outline" bind:tap="gotoPointSettings">积分设置</t-button>
      <t-button size="small" variant="outline" bind:tap="onLogoutAdmin">退出</t-button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card muted-card">加载订单与商品数据…</view>

  <view class="tabs">
    <view class="tab {{activeTab==='orders'?'active':''}}" data-tab="orders" bind:tap="onTabChange">订单管理</view>
    <view class="tab {{activeTab==='products'?'active':''}}" data-tab="products" bind:tap="onTabChange">库存管理</view>
    <view class="tab {{activeTab==='categories'?'active':''}}" data-tab="categories" bind:tap="onTabChange">分类管理</view>
    <view class="tab {{activeTab==='coupons'?'active':''}}" data-tab="coupons" bind:tap="onTabChange">优惠券</view>
  </view>

  <view wx:if="{{activeTab==='orders'}}">
    <view wx:if="{{!loading && orders.length===0}}" class="card muted-card">暂无订单。若刚登录，请确认小程序后台已配置 request 合法域名且网络正常。</view>
    <view class="card" wx:for="{{orders}}" wx:key="orderNo" wx:for-item="item">
      <view class="row"><text>订单号:</text><text>{{item.orderNo}}</text></view>
      <view class="row"><text>买家:</text><text>{{item.nickName || '匿名用户'}} / {{item.phoneNumber || '-'}}</text></view>
      <view class="row"><text>状态:</text><text>{{item.orderStatusName}}</text></view>
      <view class="row"><text>运单:</text><text>{{item.logisticsCompanyName || '-'}} {{item.logisticsNo || ''}}</text></view>
      <view class="row"><text>收货人:</text><text>{{item._receiverText || '-'}}</text></view>
      <view class="row"><text>地址:</text><text class="row-right">{{item._addressText || '-'}}</text></view>
      <view class="row"><text>商品:</text><text class="row-right">{{item._itemsSummary || '-'}}</text></view>
      <view wx:if="{{expandedOrderNo === item.orderNo}}" class="order-detail">
        <view class="order-detail-title">购买明细</view>
        <view wx:if="{{item._items && item._items.length}}">
          <view class="order-detail-item" wx:for="{{item._items}}" wx:key="index" wx:for-item="g">
            <text class="order-detail-item__name">{{g.title}}</text>
            <text class="order-detail-item__qty">×{{g.qty}}</text>
          </view>
        </view>
        <view wx:else class="order-detail-empty">-</view>
      </view>
      <view class="btn-row">
        <t-button size="small" variant="outline" bind:tap="onToggleOrderDetail" data-item="{{item}}">
          {{expandedOrderNo === item.orderNo ? '收起' : '明细'}}
        </t-button>
        <t-button size="small" theme="primary" bind:tap="onFillShipping" data-item="{{item}}">运单</t-button>
        <t-button size="small" variant="outline" bind:tap="onChangeOrderStatus" data-item="{{item}}">状态</t-button>
        <t-button size="small" variant="outline" bind:tap="onViewLogisticsTrace" data-item="{{item}}">轨迹</t-button>
        <t-button size="small" variant="outline" bind:tap="onDeleteOrder" data-item="{{item}}">删除</t-button>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab==='products'}}">
    <view wx:if="{{!loading && products.length===0}}" class="card muted-card">暂无商品，可在下方表单新增。</view>
    <view class="card form-card">
      <view class="form-title">新增商品</view>
      <t-input label="商品名" placeholder="必填" value="{{productForm.title}}" data-key="title" bind:change="onProductInput" />
      <t-input
        label="价格(元)"
        type="number"
        placeholder="必填，如 12.9"
        value="{{productForm.price}}"
        data-key="price"
        bind:change="onProductInput"
      />
      <t-input
        label="原价(元)"
        type="number"
        placeholder="选填"
        value="{{productForm.originPrice}}"
        data-key="originPrice"
        bind:change="onProductInput"
      />
      <t-input
        label="库存"
        type="number"
        placeholder="必填"
        value="{{productForm.stock}}"
        data-key="stock"
        bind:change="onProductInput"
      />
      <t-button variant="outline" block bind:tap="pickCategory">
        选择分类 {{productForm.category ? '(' + productForm.category + ')' : ''}}
      </t-button>
      <t-input label="图片URL" placeholder="选填" value="{{productForm.image}}" data-key="image" bind:change="onProductInput" />
      <t-button variant="outline" block bind:tap="onPickImage">拍照/相册上传图片</t-button>
      <image wx:if="{{productForm.image}}" class="image-preview" src="{{productForm.image}}" mode="aspectFill" />
      <t-input label="品牌" placeholder="选填" value="{{productForm.brand}}" data-key="brand" bind:change="onProductInput" />
      <t-input label="公司" placeholder="选填" value="{{productForm.company}}" data-key="company" bind:change="onProductInput" />
      <t-input
        label="描述"
        placeholder="选填"
        value="{{productForm.description}}"
        data-key="description"
        bind:change="onProductInput"
      />
      <t-button theme="primary" block loading="{{createSubmitting}}" disabled="{{createSubmitting}}" bind:tap="onCreateProduct">
        新增商品并写入数据库
      </t-button>
    </view>

    <view class="card" wx:for="{{products}}" wx:key="id" wx:for-item="item">
      <view class="row"><text>商品:</text><text>{{item.title}}</text></view>
      <view class="row"><text>库存:</text><text>{{item.stock}}</text></view>
      <view class="btn-row">
        <t-button size="small" theme="primary" bind:tap="onEditStock" data-item="{{item}}">改库存</t-button>
        <t-button size="small" variant="outline" bind:tap="gotoEditProduct" data-id="{{item.id}}">编辑商品</t-button>
        <t-button size="small" variant="outline" bind:tap="onDeleteProduct" data-item="{{item}}">删除</t-button>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab==='categories'}}">
    <view class="card form-card">
      <view class="form-title">商品分类</view>
      <view class="hint-text">以下分类会显示在客户端「分类」页侧边栏；新增或改名后，上架商品时选择对应分类即可。</view>
      <t-button theme="primary" block bind:tap="onAddCategory">新增分类</t-button>
    </view>
    <view class="card" wx:for="{{adminCategories}}" wx:key="id" wx:for-item="item">
      <view class="row category-row">
        <text class="category-name">{{item.name}}</text>
        <view class="btn-row category-actions">
          <t-button size="small" variant="outline" bind:tap="onEditCategory" data-item="{{item}}">编辑</t-button>
          <t-button size="small" variant="outline" bind:tap="onDeleteCategory" data-item="{{item}}">删除</t-button>
        </view>
      </view>
    </view>
    <view wx:if="{{adminCategories.length===0 && !categoriesLoading}}" class="card muted-card">暂无分类，请点击「新增分类」。</view>
    <view wx:if="{{categoriesLoading}}" class="card muted-card">加载中…</view>
  </view>

  <view wx:if="{{activeTab==='coupons'}}">
    <view class="card form-card">
      <view class="form-title">创建优惠券</view>
      <t-input label="名称" placeholder="例如：新用户立减券" value="{{couponForm.name}}" data-key="name" bind:change="onCouponInput" />
      <t-input label="类型(1折扣/2满减)" type="number" value="{{couponForm.type}}" data-key="type" bind:change="onCouponInput" />
      <t-input label="面值/折扣值" type="number" value="{{couponForm.value}}" data-key="value" bind:change="onCouponInput" />
      <t-input label="门槛(分)" type="number" value="{{couponForm.base}}" data-key="base" bind:change="onCouponInput" />
      <t-input label="总量" type="number" value="{{couponForm.totalCount}}" data-key="totalCount" bind:change="onCouponInput" />
      <t-input label="开始日期" placeholder="YYYY-MM-DD" value="{{couponForm.startDate}}" data-key="startDate" bind:change="onCouponInput" />
      <t-input label="结束日期" placeholder="YYYY-MM-DD" value="{{couponForm.endDate}}" data-key="endDate" bind:change="onCouponInput" />
      <t-button theme="primary" block bind:tap="onCreateCoupon">创建优惠券</t-button>
    </view>

    <view class="card form-card" wx:if="{{couponEditingId}}">
      <view class="form-title">编辑优惠券 #{{couponEditingId}}</view>
      <t-input label="名称" value="{{couponEditForm.name}}" data-key="name" bind:change="onCouponEditInput" />
      <t-input label="类型(1折扣/2满减)" type="number" value="{{couponEditForm.type}}" data-key="type" bind:change="onCouponEditInput" />
      <t-input label="面值/折扣值" type="number" value="{{couponEditForm.value}}" data-key="value" bind:change="onCouponEditInput" />
      <t-input label="门槛(分)" type="number" value="{{couponEditForm.base}}" data-key="base" bind:change="onCouponEditInput" />
      <t-input label="总量" type="number" value="{{couponEditForm.totalCount}}" data-key="totalCount" bind:change="onCouponEditInput" />
      <t-input label="开始日期" placeholder="YYYY-MM-DD" value="{{couponEditForm.startDate}}" data-key="startDate" bind:change="onCouponEditInput" />
      <t-input label="结束日期" placeholder="YYYY-MM-DD" value="{{couponEditForm.endDate}}" data-key="endDate" bind:change="onCouponEditInput" />
      <t-input label="状态(enabled/disabled)" value="{{couponEditForm.status}}" data-key="status" bind:change="onCouponEditInput" />
      <view class="btn-row">
        <t-button size="small" theme="primary" bind:tap="onSaveCouponEdit">保存</t-button>
        <t-button size="small" variant="outline" bind:tap="cancelEditCoupon">取消</t-button>
      </view>
    </view>
    <view class="card" wx:for="{{coupons}}" wx:key="id" wx:for-item="item">
      <view class="row"><text>ID:</text><text>{{item.id}}</text></view>
      <view class="row"><text>名称:</text><text>{{item.name}}</text></view>
      <view class="row"><text>类型:</text><text>{{item.type === 2 ? '满减' : '折扣'}}</text></view>
      <view class="row"><text>面值:</text><text>{{item.value}}</text></view>
      <view class="row"><text>门槛:</text><text>{{item.base}}</text></view>
      <view class="row"><text>有效期:</text><text>{{item.startTime}} ~ {{item.endTime}}</text></view>
      <view class="row"><text>状态:</text><text>{{item.status}}</text></view>
      <view class="row"><text>库存:</text><text>{{item.issuedCount}} / {{item.totalCount}}</text></view>
      <view class="btn-row">
        <t-button size="small" variant="outline" bind:tap="onGrantCouponAll" data-item="{{item}}">发给全部用户</t-button>
        <t-button size="small" variant="outline" bind:tap="openEditCoupon" data-item="{{item}}">编辑</t-button>
        <t-button size="small" variant="outline" bind:tap="onDeleteCoupon" data-item="{{item}}">删除</t-button>
      </view>
    </view>
    <view wx:if="{{coupons.length===0 && !couponsLoading}}" class="card muted-card">暂无优惠券。</view>
    <view wx:if="{{couponsLoading}}" class="card muted-card">加载中…</view>
  </view>
</view>
<t-toast id="t-toast" />
