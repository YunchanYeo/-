@import '../_admin-theme.wxss';

.admin-login {
  padding: 32rpx 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #fff5ef 0%, #f7f8fa 45%, #f5f5f5 100%);
}

.login-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(250, 65, 38, 0.08);
  border: 1rpx solid rgba(255, 228, 211, 0.95);
}

.login-card .title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tip {
  color: #999;
  margin-bottom: 24rpx;
  font-size: 24rpx;
}
