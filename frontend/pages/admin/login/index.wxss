.admin-login {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5ef 0%, #ffffff 60%);
}

.login-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(250, 85, 15, 0.08);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tip {
  color: #999;
  margin-bottom: 24rpx;
  font-size: 24rpx;
}
