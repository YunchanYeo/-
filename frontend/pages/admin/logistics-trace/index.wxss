.trace-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.state {
  padding: 48rpx;
  text-align: center;
  font-size: 28rpx;
}

.state.muted {
  color: #888;
}

.state.err {
  color: #c00;
}

.summary {
  padding: 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #e8e8e8;
}

.summary-line {
  font-size: 28rpx;
  color: #111;
  font-weight: 600;
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.route-map {
  width: 100%;
  height: 360rpx;
  flex-shrink: 0;
}

.trace-list {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 16rpx 0 32rpx;
  box-sizing: border-box;
}

.pad {
  padding: 32rpx;
}

.trace-row {
  margin: 0 24rpx 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.trace-time {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.trace-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.trace-ctx {
  font-size: 28rpx;
  color: #222;
  line-height: 1.45;
}

.trace-area {
  font-size: 24rpx;
  color: #576b95;
}
