@import '../_admin-theme.wxss';

.trace-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff5ef 0%, #f7f8fa 28%, #f5f5f5 100%);
}

.state {
  padding: 48rpx;
  text-align: center;
  font-size: 28rpx;
}

.state.muted {
  color: #888;
}

.state.err {
  color: #c00;
}

.summary {
  padding: 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(255, 228, 211, 0.65);
  box-shadow: 0 4rpx 16rpx rgba(250, 65, 38, 0.04);
}

.summary-line {
  font-size: 28rpx;
  color: #111;
  font-weight: 600;
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.status-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-badge {
  display: inline-block;
  background: #fff0ea;
  color: #c53d12;
  border-radius: 24rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  border: 1rpx solid rgba(250, 65, 38, 0.2);
}

.copy-btn {
  margin: 0;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #fa4126;
  border-color: rgba(250, 65, 38, 0.35);
}

.latest {
  margin-top: 12rpx;
  display: block;
  color: #222;
  font-size: 27rpx;
  line-height: 1.45;
}

.latest-time {
  margin-top: 6rpx;
  display: block;
  color: #888;
  font-size: 22rpx;
}

.setup-card {
  margin: 18rpx 24rpx 0;
  padding: 20rpx;
  background: #fff8f0;
  border: 1rpx solid #ffd4c2;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(250, 65, 38, 0.06);
}

.setup-title {
  color: #b34700;
  font-size: 28rpx;
  font-weight: 600;
}

.setup-sub {
  margin-top: 12rpx;
  color: #8a4a22;
  font-size: 24rpx;
}

.setup-step {
  margin-top: 8rpx;
  color: #7a4a28;
  font-size: 24rpx;
  line-height: 1.5;
}

.route-map {
  width: 100%;
  height: 360rpx;
  flex-shrink: 0;
}

.trace-list {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 16rpx 0 32rpx;
  box-sizing: border-box;
}

.pad {
  padding: 32rpx;
}

.trace-row {
  margin: 0 24rpx 20rpx;
  padding: 20rpx 24rpx 20rpx 46rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(250, 65, 38, 0.06);
  position: relative;
  border: 1rpx solid rgba(255, 228, 211, 0.5);
}

.trace-row-active {
  border: 1rpx solid rgba(250, 65, 38, 0.35);
  box-shadow: 0 8rpx 22rpx rgba(250, 65, 38, 0.12);
}

.trace-dot {
  position: absolute;
  left: 18rpx;
  top: 30rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d4d4d4;
}

.trace-dot-active {
  background: #fa4126;
  box-shadow: 0 0 0 6rpx rgba(250, 65, 38, 0.2);
}

.trace-time {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.trace-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.trace-ctx {
  font-size: 28rpx;
  color: #222;
  line-height: 1.45;
}

.trace-area {
  font-size: 24rpx;
  color: #fa4126;
}
