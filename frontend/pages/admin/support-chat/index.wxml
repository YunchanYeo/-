<view class="admin-chat-page">
  <view class="left">
    <view
      wx:for="{{conversations}}"
      wx:key="userId"
      class="user-item {{String(item.userId)===String(activeUserId)?'active':''}}"
      data-user-id="{{item.userId}}"
      bindtap="onSelectConversation"
    >
      <view class="name">{{item.nickName || ('用户' + item.userId)}}</view>
      <view class="unread" wx:if="{{item.unreadCount>0}}">{{item.unreadCount}}</view>
    </view>
  </view>
  <view class="right">
    <scroll-view
      class="msg-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollIntoView}}"
      scroll-with-animation="{{true}}"
    >
      <view class="msg-pad">
        <view
          wx:for="{{messages}}"
          wx:key="id"
          id="msg-{{item.id}}"
          class="msg-row {{item.fromRole === 'admin' ? 'msg-row--mine' : 'msg-row--other'}}"
        >
          <view class="avatar avatar--other" wx:if="{{item.fromRole !== 'admin'}}">
            <text class="avatar-text">用</text>
          </view>
          <view class="col-bubble">
            <view wx:if="{{item.msgType === 'text'}}" class="bubble bubble--text">{{item.content}}</view>
            <image
              wx:elif="{{item.msgType === 'image'}}"
              class="bubble bubble--img"
              src="{{item.displayUrl}}"
              mode="widthFix"
              lazy-load="{{true}}"
              bindtap="onPreviewImage"
              data-url="{{item.displayUrl}}"
            />
            <view
              wx:elif="{{item.msgType === 'voice'}}"
              class="bubble bubble--voice {{item.fromRole === 'admin' ? 'bubble--voice--mine' : 'bubble--voice--other'}}"
              style="width: {{item.voiceBarWidth}}rpx;"
              bindtap="onPlayVoice"
              data-url="{{item.displayUrl}}"
              data-id="{{item.id}}"
            >
              <view class="voice-inner voice-inner--mine" wx:if="{{item.fromRole === 'admin'}}">
                <text class="voice-sec">{{item.voiceSec}}″</text>
                <image
                  class="voice-icon {{playingVoiceId == item.id ? 'voice-icon--playing' : ''}}"
                  src="/assets/chat-voice-icon.png"
                  mode="aspectFit"
                />
              </view>
              <view class="voice-inner" wx:else>
                <image
                  class="voice-icon voice-icon--other {{playingVoiceId == item.id ? 'voice-icon--playing' : ''}}"
                  src="/assets/chat-voice-icon.png"
                  mode="aspectFit"
                />
                <text class="voice-sec">{{item.voiceSec}}″</text>
              </view>
            </view>
          </view>
          <view class="avatar avatar--mine" wx:if="{{item.fromRole === 'admin'}}">
            <text class="avatar-text">服</text>
          </view>
        </view>
        <view class="scroll-bottom-anchor" id="msg-bottom"></view>
      </view>
    </scroll-view>

    <view wx:if="{{recording}}" class="record-overlay" catchtouchmove="noop">
      <view class="record-panel {{recordWillCancel ? 'record-panel--cancel' : ''}}">
        <view class="record-icon-wrap">
          <image class="record-panel-icon" src="/assets/chat-voice-icon.png" mode="aspectFit" />
        </view>
        <text class="record-hint">{{recordWillCancel ? '松开手指，取消发送' : '拖动到下方 X 区域取消'}}</text>
      </view>
      <view class="record-cancel-zone {{recordWillCancel ? 'record-cancel-zone--active' : ''}}">
        <text class="record-cancel-x">X</text>
      </view>
    </view>

    <view class="input-dock safe-bottom">
      <view class="tool-btn" hover-class="tool-btn--hover" bindtap="toggleInputMode">
        <image wx:if="{{inputMode !== 'voice'}}" class="tool-voice-icon" src="/assets/chat-voice-icon.png" mode="aspectFit" />
        <text wx:else class="tool-icon-key">⌨</text>
      </view>
      <block wx:if="{{inputMode !== 'voice'}}">
        <input
          class="text-field"
          placeholder="发送消息"
          placeholder-class="text-field-ph"
          confirm-type="send"
          confirm-hold="{{false}}"
          value="{{inputText}}"
          bindinput="onInput"
          bindconfirm="onSend"
        />
      </block>
      <view
        wx:else
        class="press-talk {{recording ? 'press-talk--active' : ''}}"
        catchtouchstart="onRecordStart"
        catchtouchmove="onRecordMove"
        catchtouchend="onRecordEnd"
        catchtouchcancel="onRecordCancel"
      >
        {{recording ? '松开 发送' : '按住 说话'}}
      </view>
      <view class="tool-btn tool-btn--plus" hover-class="tool-btn--hover" bindtap="openMoreActions">
        <text class="tool-plus">+</text>
      </view>
      <button
        wx:if="{{inputMode !== 'voice' && inputText}}"
        class="send-btn"
        loading="{{sending}}"
        disabled="{{sending}}"
        bindtap="onSend"
      >
        发送
      </button>
    </view>
  </view>
</view>
<t-toast id="t-toast" />
