.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
}

.hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.thumb-block {
  margin: 24rpx 0;
}

.field-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.thumb-preview-wrap {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.thumb-preview {
  width: 160rpx;
  height: 160rpx;
}

.thumb-hint {
  display: block;
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
