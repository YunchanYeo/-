.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: linear-gradient(180deg, #fff5ef 0%, #f7f8fa 42%, #f7f8fa 100%);
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #ffe4d3;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #222;
}

.sub {
  color: #888;
  font-size: 24rpx;
  margin-bottom: 18rpx;
}

.create-hint {
  color: #888;
  font-size: 22rpx;
  line-height: 1.45;
  margin: 8rpx 0 16rpx;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 18rpx 0;
}

