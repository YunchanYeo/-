{
	# HTTP/3(QUIC) 끔. 일부 위챗 WebView / 회선에서만 RST 나는 경우 h2 자체를 끄고 h1만 사용
	servers {
		protocols h1
	}
}

# 공인 IP 바뀌면 sslip/nip 호스트를 같은 규칙으로 수정하세요.
# Let's Encrypt: 외부 TCP 80·443 필요. `deploy/china-test` 에서 `docker compose up -d` 시 Caddy 함께 기동.
#
# tls: 위챗 실기 Android 일부에서 TLS1.3·ECDSA·ALPN h2 조합으로 RST 나는 사례가 있어
#      TLS1.2 고정 + RSA 키로 완화 (문서·커뮤니티 점검용).

39-106-213-185.sslip.io {
	log {
		output stdout
		format console
	}
	tls {
		protocols tls1.2
		key_type rsa2048
	}
	reverse_proxy admin-web:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

