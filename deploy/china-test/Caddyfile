{
	# HTTP/3(QUIC) 끔. 일부 위챗 WebView / 회선에서만 RST 나는 경우 h2 자체를 끄고 h1만 사용
	servers {
		protocols h1
	}
}

# ━━━ Caddy + SSL(Let's Encrypt) ━━━
# - 아래 `hebibingtest.shop`·sslip·nip 블록은 호스트명만 적으면 Caddy가 ACME로 인증서 자동 발급·갱신합니다.
# - tls { … } 는 「프로토콜·키 타입」만 지정하는 것이며, 인증서 파일을 수동 넣는 설정이 아닙니다.
# - 발급 전제: DNS A(또는 CNAME)가 이 ECS 공인 IP를 가리킴, 보안그룹·방화벽에서 80·443 인바운드 허용,
#   호스트에 다른 프로세스가 80/443 점유하지 않음, `deploy/china-test` 에서 `docker compose up -d` 로 caddy 기동.
# - 점검: `bash deploy/china-test/check-mp-https-hosts.sh`(미니프로그램용 호스트 일괄) 또는 `bash deploy/china-test/check-ssl.sh hebibingtest.shop`
# - 공인 IP·임시 호스트만 바꿀 때: sslip/nip 호스트 문자열을 같은 규칙으로 수정.
#
# tls: 위챗 실기 Android 일부에서 TLS1.3·ECDSA·ALPN h2 조합으로 RST 나는 사례가 있어
#      TLS1.2 고정 + RSA 키로 완화 (문서·커뮤니티 점검용).

39-106-213-185.sslip.io {
	log {
		output stdout
		format console
	}
	tls {
		protocols tls1.2
		key_type rsa2048
	}
	reverse_proxy admin-web:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

39.106.213.185.nip.io {
	log {
		output stdout
		format console
	}
	tls {
		protocols tls1.2
		key_type rsa2048
	}
	reverse_proxy admin-web:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

# 정식 도메인(微信小程序 request合法域名과 동일 호스트 권장)
hebibingtest.shop {
	log {
		output stdout
		format console
	}
	tls {
		protocols tls1.2
		key_type rsa2048
	}
	reverse_proxy admin-web:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
