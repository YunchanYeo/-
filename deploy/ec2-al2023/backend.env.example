# EC2 Docker 는 `deploy/ec2-al2023/docker-compose.yml` 이 레포 루트의 `backend/.env` 만 읽습니다.
# 이 파일은 그 `.env` 를 채울 때 참고용 템플릿입니다. 복사: `cp deploy/ec2-al2023/backend.env.example backend/.env` (레포 루트에서)
# `backend/.env` 는 Git 에 올리지 마세요.

PORT=3000
NODE_ENV=production
LISTEN_HOST=0.0.0.0

# 컨테이너 안에서는 Caddy 가 TLS 를 종료하므로, 백엔드는 HTTP:3000 만 쓰면 됩니다.
# dev-local 인증서를 마운트하지 않는 한 TLS_KEY_FILE / TLS_CERT_FILE 은 비워 두세요.

# 공개 사이트 원점 — Caddyfile 의 사이트 이름과 동일한 HTTPS 원점(끝 / 없음)
# 예: sslip 점검 시 https://13-124-255-73.sslip.io  (IP 바뀌면 sslip 호스트도 변경)
PUBLIC_UPLOAD_BASE_URL=https://YOUR_PUBLIC_HTTPS_HOST
API_PUBLIC_BASE_URL=https://YOUR_PUBLIC_HTTPS_HOST

# 위챗·알리 결제 알림 URL (HTTPS, 경로 고정). 위 호스트와 동일 도메인 권장
WECHAT_PAY_NOTIFY_URL=https://YOUR_PUBLIC_HTTPS_HOST/api/wechat-pay/notify
ALIPAY_NOTIFY_URL=https://YOUR_PUBLIC_HTTPS_HOST/api/alipay/notify

# 위챗小程序 AppID/Secret 등은 backend/.env.example 참고해 동일하게 설정
# WECHAT_APPID=
# WECHAT_APPSECRET=
# WECHAT_PAY_MOCK=true

# 관리자 — 최초 기동 시 `admins` 테이블이 비어 있으면 이 값으로 1명 자동 생성됨. 비워 두면 관리자 로그인 불가.
ADMIN_USERNAME=admin
# 비밀번호에 @ # 등이 있으면 Docker env_file 에서는 큰따옴표로 감싸는 것이 안전할 수 있습니다.
ADMIN_PASSWORD=여기에_강한_비밀번호
# 비밀번호를 .env 와 DB에 맞추고 싶을 때만 true (맞춘 뒤 false 권장)
ADMIN_SYNC_ON_START=false
