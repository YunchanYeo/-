# 이 파일을 복사해 `backend.env` 로 저장한 뒤 값을 채우세요. `backend.env` 는 Git 에 올리지 마세요.
# 참고: `backend/.env.example` 전체 항목 설명

PORT=3000
NODE_ENV=production
LISTEN_HOST=0.0.0.0

# 컨테이너 안에서는 Caddy 가 TLS 를 종료하므로, 백엔드는 HTTP:3000 만 쓰면 됩니다.
# dev-local 인증서를 마운트하지 않는 한 TLS_KEY_FILE / TLS_CERT_FILE 은 비워 두세요.

# 공개 사이트 원점 — 반드시 실제 HTTPS 도메인(끝 / 없음)
PUBLIC_UPLOAD_BASE_URL=https://hebibingtest.shop
API_PUBLIC_BASE_URL=https://hebibingtest.shop

# 위챗·알리 결제 알림 URL (운영 시 HTTPS, 경로 고정)
WECHAT_PAY_NOTIFY_URL=https://hebibingtest.shop/api/wechat-pay/notify
ALIPAY_NOTIFY_URL=https://hebibingtest.shop/api/alipay/notify

# 위챗小程序 AppID/Secret 등은 backend/.env.example 참고해 동일하게 설정
# WECHAT_APPID=
# WECHAT_APPSECRET=
# WECHAT_PAY_MOCK=true

# 관리자 (선택)
# ADMIN_SYNC_ON_START=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=강한_비밀번호
