{
  "name": "wechat-mini-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "sh -c \"pkill -f 'vite.*5174' >/dev/null 2>&1 || true; npm --prefix ../admin-web run dev -- --host 127.0.0.1 --port 5174 --strictPort\"",
    "dev:api": "open \"http://127.0.0.1:5174\" >/dev/null 2>&1; tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:docker": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/index.js",
    "test": "vitest run",
    "start:dist": "node dist/index.js",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "probe:wechat-pay": "tsx src/scripts/probeWechatPay.ts",
    "migrate:pg": "tsx src/scripts/migrateSqliteToPostgres.ts",
    "migrate:oss": "tsx src/scripts/migrateUploadsToOss.ts"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "latest",
    "cors": "latest",
    "dotenv": "^17.4.2",
    "express": "latest",
    "multer": "^2.1.1",
    "pg": "^8.16.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.16.11",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
