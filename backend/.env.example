PORT=3000
# 微信支付：WECHAT_PAY_MOCK=false 且商户参数齐全时调用「JSAPI 统一下单」并返回 RSA paySign；否则仍为模拟 prepay_id=mock_*（真实收款勿依赖模拟）。
WECHAT_PAY_MOCK=true
WECHAT_APPID=wxdd12341e879d5d6b
WECHAT_APPSECRET=
# —— 商户号 / API v3（商户平台「API 安全」）——
WECHAT_MCH_ID=
WECHAT_PAY_SERIAL_NO=
# 商户 API 私钥 PEM（内容可用单行，换行写 \\n）
WECHAT_PAY_PRIVATE_KEY=
# 异步通知 URL：须公网 HTTPS，与商户平台配置一致，路径示例 .../api/wechat-pay/notify
WECHAT_PAY_NOTIFY_URL=
# API v3 密钥（32 字符），解密支付结果通知
WECHAT_PAY_API_V3_KEY=
# 可选：微信平台证书 PEM，用于校验 notify 签名（生产强烈建议）
WECHAT_PAY_PLATFORM_CERT_PEM=

# 快递100 实时查询（管理端物流轨迹）：https://api.kuaidi100.com/document/5f0ffb5ebc8da837cbd8aefc.html
# 说明：覆盖顺丰/三通一达等的主流「聚合轨迹」接口几乎都是企业付费或试用额度；没有长期稳定、官方承诺免费的全国统一查询 API。
# 低成本备选：各快递公司开放平台（需入驻）、阿里云/聚合数据等平台的试用包、或自建爬虫（合规与稳定性差，不推荐生产使用）。
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=

# 管理员：`npm run seed:admin` 或 ADMIN_SYNC_ON_START=true，将下列账号口令写入 SQLite admins（bcrypt）。
# POST /api/admin/login 只校验数据库中的 passwordHash / 明文 password，不直接读这两项做运行时比对。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now
ADMIN_SYNC_ON_START=false

# ===== 2단계 인프라 전환 옵션 =====
# 미디어 저장소: 기본(local), aliyun-oss 로 설정 시 OSS 사용
MEDIA_PROVIDER=local

# 阿里云 OSS
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 권장: CDN/커스텀 도메인 (예: https://cdn.example.com)
OSS_PUBLIC_BASE_URL=

# PostgreSQL (RDS) 이관용
POSTGRES_URL=