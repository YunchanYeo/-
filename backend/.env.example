PORT=3000
# 本地 HTTPS（小程序 wx-image 需 HTTPS）：`npm run gen:dev-tls` → certs/dev-local/key.pem + cert.pem 存在时自动走 HTTPS；或自定义：
# TLS_KEY_FILE=
# TLS_CERT_FILE=

# 小程序「我的」客服热线等（GET /api/app-config → customerServicePhone）。未设置时前端用 frontend/config 内 customerServicePhone 兜底
CUSTOMER_SERVICE_PHONE=
# 微信支付：WECHAT_PAY_MOCK=false 且商户参数齐全时调用「JSAPI 统一下单」并返回 RSA paySign；否则仍为模拟 prepay_id=mock_*（真实收款勿依赖模拟）。
WECHAT_PAY_MOCK=true
WECHAT_APPID=
WECHAT_APPSECRET=
# —— 商户号 / API v3（商户平台「API 安全」）——
WECHAT_MCH_ID=
WECHAT_PAY_SERIAL_NO=
# 商户 API 私钥：二选一。推荐将 apiclient_key.pem 放入 backend/certs/wechat-pay/（可留空本项）
# 或 PEM 内联（换行写 \\n），或 WECHAT_PAY_PRIVATE_KEY_FILE=/绝对路径/apiclient_key.pem
WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_PRIVATE_KEY_FILE=
# 异步通知 URL：须公网 HTTPS，与商户平台配置一致，路径示例 .../api/wechat-pay/notify
WECHAT_PAY_NOTIFY_URL=
# API v3 密钥（32 字符），解密支付结果通知
WECHAT_PAY_API_V3_KEY=
# 可选：微信平台证书 PEM，用于校验 notify 签名；或放 backend/certs/wechat-pay/wechatpay_cert.pem
WECHAT_PAY_PLATFORM_CERT_PEM=
# WECHAT_PAY_PLATFORM_CERT_FILE=

# 支付宝「手机网站支付」alipay.trade.wap.pay（文档：https://opendocs.alipay.com/open-v3/05w4kr ）
# 微信小程序内用 web-view 打开服务端返回的表单 HTML，再唤起支付宝 App。
# ALIPAY_PAY_MOCK=false 且下列密钥齐全时走真实网关；否则与微信 mock 一样可弹窗模拟成功。
ALIPAY_PAY_MOCK=true
ALIPAY_APP_ID=
# 应用私钥 PEM、支付宝公钥 PEM（换行可写 \\n）
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
# 异步通知须公网 HTTPS，例如 .../api/alipay/notify
ALIPAY_NOTIFY_URL=
# 可选：沙箱 https://openapi.alipaydev.com/gateway.do ；默认正式 https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=
# web-view 与 return_url/quit_url 使用的公网 API 根地址（须 HTTPS，与小程序「业务域名」一致）
API_PUBLIC_BASE_URL=
# wap-launch / return / quit 链接 HMAC 密钥（生产务必自定义）
PAY_LAUNCH_TOKEN_SECRET=

# 快递100 实时查询（管理端物流轨迹）：https://api.kuaidi100.com/document/5f0ffb5ebc8da837cbd8aefc.html
# 说明：覆盖顺丰/三通一达等的主流「聚合轨迹」接口几乎都是企业付费或试用额度；没有长期稳定、官方承诺免费的全国统一查询 API。
# 低成本备选：各快递公司开放平台（需入驻）、阿里云/聚合数据等平台的试用包、或自建爬虫（合规与稳定性差，不推荐生产使用）。
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=

# 管理员：`npm run seed:admin` 或 ADMIN_SYNC_ON_START=true，将下列账号口令写入 SQLite admins（bcrypt）。
# POST /api/admin/login 只校验数据库中的 passwordHash / 明文 password，不直接读这两项做运行时比对。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now
ADMIN_SYNC_ON_START=false

# ===== 2단계 인프라 전환 옵션 =====
# 미디어 저장소: local(기본·ECS 도 디스크) — OSS 쓰지 않을 때는 local 유지 또는 생략
MEDIA_PROVIDER=aliyun-oss
# 공인 사이트 원점(https) — 관리자 상품 이미지 반환 URL·채팅 등 로컬 파일 URL에 사용
# 관리자 상품 사진은 DB(product_media BLOB) 저장, 주소 예: .../api/media/product/123
# 로컬 HTTPS 调试：若设置请与前端一致，例如 https://127.0.0.1:3000；不设则由请求的 Host 推导
PUBLIC_UPLOAD_BASE_URL=

# 阿里云 OSS（须与控制台 Endpoint 一致，例如 oss-cn-hangzhou；勿写成 cn-hangzhou 以免域名错误）
OSS_REGION=oss-cn-hangzhou
# 例：wechat-mini-test-media（与控制台_bucket_名一致）
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 권장: CDN/커스텀 도메인 (예: https://cdn.example.com)
OSS_PUBLIC_BASE_URL=

# DB: 비우거나 삭제 = 로컬 SQLite (`backend/data/app.sqlite`). 런타임은 항상 SQLite만 사용함.
# PostgreSQL(RDS) 데이터 이관·스크립트용일 때만 연결 문자열 설정: `npm run migrate:pg` 등
# POSTGRES_URL=postgresql://user:pass@host:5432/dbname
POSTGRES_URL=

# 浏览器直连后端（生产或后端单独端口时用）
# VITE_API_BASE_URL=http://127.0.0.1:3000

# 本地开发：留空则请求同源，由 vite 代理到后端（见 vite.config.ts）
VITE_API_BASE_URL=

# vite dev 代理目标（默认 https://127.0.0.1:3000，与 `npm run gen:dev-tls` 后仅 HTTPS 监听的后端一致；自签证书由 vite secure:false 处理）
# 若后端未启用 TLS、仅 HTTP 监听，请改为：
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
VITE_DEV_PROXY_TARGET=https://127.0.0.1:3000

# 与小程序 `frontend/config/index.js` 中的 apiBaseUrl 指向同一后端时，管理员账号一致。
